      "kind": "nav",
      "description": "Bold current page link with a green baseline marker.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#\" aria-current=\"page\">Find Your Path</a></nav>",
      "css": ".ds-nav{height:96px;display:flex;border-bottom:1px solid var(--color-line)}.ds-nav a{display:flex;align-items:center;position:relative;font:700 13px var(--font-sans),sans-serif;color:var(--color-ink);text-decoration:none}.ds-nav a::after{content:\"\";position:absolute;left:0;right:0;bottom:-1px;height:3px;background:var(--color-primary);border-radius:3px}.ds-nav a:focus-visible{outline:3px solid #428764;outline-offset:5px}"
    },
    {
      "name": "Category filter",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "Category button and its pressed state.",
      "html": "<div class=\"ds-filters\" role=\"group\" aria-label=\"Filter majors by field\"><button class=\"ds-chip\" aria-pressed=\"true\">All majors</button><button class=\"ds-chip\" aria-pressed=\"false\">Technology</button></div>",
      "css": ".ds-filters{display:flex;gap:8px}.ds-chip{min-height:36px;border:1px solid #dbe2d6;background:transparent;border-radius:7px;padding:8px 14px;font:600 11px var(--font-sans),sans-serif;color:var(--color-ink);white-space:nowrap;cursor:pointer;transition:background .2s,border-color .2s}.ds-chip:hover{background:#e3ebdc;border-color:#b7c8af}.ds-chip[aria-pressed=\"true\"]{background:var(--color-primary);color:white;border-color:var(--color-primary)}.ds-chip:focus-visible{outline:3px solid #428764;outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-chip{transition:none}}"
    },
