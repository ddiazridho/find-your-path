      "css": ".ds-skills{display:flex;gap:6px;flex-wrap:wrap}.ds-skills span{background:#f3f5ef;border:1px solid #e8ece3;border-radius:5px;font:9px var(--font-sans),sans-serif;padding:5px 8px;color:#53644e}"
    },
    {
      "name": "Major card",
      "kind": "card",
      "refersTo": "major-card",
      "description": "Full-card preview action with a decorative architecture specimen; no working simulation.",
      "html": "<button class=\"ds-card\" aria-label=\"Preview Architecture simulation\"><div class=\"ds-visual\" aria-hidden=\"true\"><div class=\"ds-plan\"><div class=\"ds-room ds-room-a\">CREATE</div><div class=\"ds-room\">CONNECT</div><div class=\"ds-room ds-room-c\">UNWIND</div></div><span class=\"ds-scale\">A place to belong · Concept plan</span><span class=\"ds-duration\"><svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>25 min</span></div><div class=\"ds-body\"><h3>Architecture</h3><span class=\"ds-category\">Design</span><p>Imagine spaces that make everyday life better.</p><div class=\"ds-card-skills\"><span>Spatial thinking</span><span>Creativity</span></div><div class=\"ds-action\"><span>Rethink a shared space</span><span class=\"ds-arrow\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></div></div></button>",
      "css": ".ds-card{display:block;width:350px;text-align:left;padding:0;border:1px solid #dfe5da;border-radius:var(--radius-card);background:var(--color-surface);color:var(--color-ink);overflow:hidden;cursor:pointer;font-family:var(--font-sans),sans-serif;transition:box-shadow .25s,border-color .25s}.ds-card:hover{box-shadow:var(--shadow-card);border-color:#a1b69b}.ds-card:focus-visible{outline:3px solid #428764;outline-offset:5px}.ds-visual{position:relative;height:216px;padding:24px 34px 0;background:var(--color-sand);overflow:hidden;color:#62634c}.ds-plan{display:grid;grid-template-columns:1.3fr 1fr;grid-template-rows:55px 55px;gap:5px;border:2px solid #82836c;padding:7px;margin-top:17px;transform:rotate(-3deg)}.ds-room{display:grid;place-items:center;border:1px solid #999982;background:#f4f0e3;font-size:7px;letter-spacing:1px}.ds-room-a{grid-row:span 2;background:#d2d6bd}.ds-room-c{background:#ded8bf}.ds-scale{display:block;font-size:7px;text-align:right;margin-top:10px}.ds-body{padding:22px 23px 17px}.ds-body h3{font-size:19px;letter-spacing:-.6px;margin:7px 0 0;font-weight:800}.ds-category{display:inline-block;margin-top:7px;font-size:10px;font-weight:600;color:var(--color-muted)}.ds-body p{font-size:12px;line-height:1.8;color:var(--color-muted);margin:9px 0 0;max-width:32ch;min-height:44px}.ds-action{margin-top:20px;padding-top:15px;border-top:1px solid #ebeee7;display:flex;align-items:center;justify-content:space-between;font-size:11px;font-weight:700;gap:8px}.ds-arrow{display:grid;place-items:center;width:28px;height:28px;background:#f0f4eb;border-radius:50%;transition:background .2s,color .2s}.ds-arrow svg{width:15px;height:15px}.ds-card:hover .ds-arrow{background:var(--color-primary);color:white}@media(prefers-reduced-motion:reduce){.ds-card{transition:none}}.ds-duration{position:absolute;top:13px;right:13px;padding:5px 8px;display:inline-flex;align-items:center;gap:4px;font-size:9px;font-weight:600;background:rgb(255 255 255 / 94%);border-radius:5px}.ds-card-skills{display:flex;gap:6px;flex-wrap:wrap;margin-top:16px}.ds-card-skills span{background:#f3f5ef;border:1px solid #e8ece3;border-radius:5px;font-size:9px;padding:5px 8px;color:#53644e}@media(prefers-reduced-motion:reduce){.ds-arrow{transition:none}}"
    },
    {
      "name": "Code task specimen",
      "kind": "custom",
      "description": "Decorative code illustration used in a mint task field, hidden from assistive technology.",
      "html": "<div class=\"ds-code-field\" aria-hidden=\"true\"><div class=\"ds-code\"><div class=\"ds-window\"><span></span><span></span><span></span><b>your-first-idea.js</b></div><div class=\"ds-lines\"><p><i>1</i><em>function</em> findYourPath() {</p><p><i>2</i>  <em>const</em> curiosity = <strong>true</strong>;</p><p><i>3</i>  <em>return</em> possibilities;</p><p><i>4</i>}</p></div><div class=\"ds-status\"><span></span> Ready to make something?</div></div></div>",
      "css": ".ds-code-field{width:302px;height:192px;padding:24px 24px 0;background:var(--color-mint);overflow:hidden;font-family:var(--font-sans),sans-serif}.ds-code{background:#244334;border-radius:8px 8px 0 0;color:#d9e6d7;height:100%;margin-top:12px;box-shadow:0 8px 18px rgb(32 59 49 / 12%);transform:rotate(-3deg)}.ds-window{height:29px;padding:10px 12px;display:flex;align-items:center;gap:4px;border-bottom:1px solid #44634e}.ds-window>span{width:5px;height:5px;border-radius:50%;background:#93b891}.ds-window>b{font-size:7px;margin-left:auto;color:#c2d5bb;font-weight:400}.ds-lines{padding:17px 12px;font:9px/2 var(--font-geist-mono),monospace;white-space:pre}.ds-lines p{margin:0}.ds-lines i{color:#a1b49e;margin-right:13px;font-style:normal}.ds-lines em{color:#d5c5ef;font-style:normal}.ds-lines strong{color:#d7d99c;font-weight:400}.ds-status{font-size:7px;display:flex;align-items:center;gap:5px;padding:9px 13px;border-top:1px solid #44634e}.ds-status span{width:4px;height:4px;background:#b7d89a;border-radius:50%}"
    }
  ],
  "narrative": {
    "northStar": "Campus creative studio",
    "overview": "An approachable, daytime visual world for students discovering university majors. Green ink, warm paper, soft pastel task fields, and confident rounded typography make exploration feel welcoming. This description records the shipped interface; it is not a separate brand promise.\n\nKeep reusable controls calm and legible. Authored task specimens supply the playful character through type, small diagrams, and restrained rotation. They are decorative previews, not working simulations, assessments, or personalized recommendations.",
    "keyCharacteristics": [
      "Warm paper and green ink.",
      "Bold Manrope headings with quiet supporting text.",
      "Pastel specimen fields within white cards.",
      "Soft controls, clear borders, and selective hover lift."
    ],
    "rules": [
      {
        "name": "The Action Green Rule",
        "body": "Use the primary green for interactive emphasis; use pastel fields to distinguish illustrative content.",
        "section": "colors"
      },
      {
        "name": "The Selective Lift Rule",
        "body": "Keep the browsing grid flat at rest and reserve its shadow for hover; retain the stronger dialog shadow for modal separation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse the global color, radius, spacing, font, and easing variables when extending the interface.",
      "Do pair green action emphasis with quiet supporting text and pastel specimen fields.",
      "Do preserve visible keyboard focus, accessible labels, and reduced-motion behavior.",
      "Do describe task specimens as previews while simulations and personalized insights remain unconnected."
    ],
    "donts": [
      "Don't turn decorative specimens into fabricated results, assessments, or recommendations.",
      "Don't add resting shadows to every card; retain the current selective elevation hierarchy.",
      "Don't promote the homepage hero composition into a requirement for every future screen."
    ]
  }
}
